{
  "name": "ExerciseItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do exerc\u00edcio"
    },
    "category": {
      "type": "string",
      "enum": [
        "pilates",
        "fisioterapia",
        "estetica",
        "outros"
      ],
      "description": "Categoria do exerc\u00edcio"
    },
    "equipment_id": {
      "type": "string",
      "description": "ID do aparelho associado (opcional)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do exerc\u00edcio"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category"
  ]
}