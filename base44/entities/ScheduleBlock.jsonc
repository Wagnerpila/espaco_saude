{
  "name": "ScheduleBlock",
  "type": "object",
  "properties": {
    "professional_id": {
      "type": "string",
      "description": "ID do profissional"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "full_day",
        "partial_day",
        "recurring_exception"
      ],
      "description": "Tipo de bloqueio: dia completo, parcial ou exce\u00e7\u00e3o recorrente"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do bloqueio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de t\u00e9rmino do bloqueio (opcional)"
    },
    "start_time": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio (para bloqueio parcial)"
    },
    "end_time": {
      "type": "string",
      "description": "Hor\u00e1rio de t\u00e9rmino (para bloqueio parcial)"
    },
    "recurring_pattern": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "monthly",
        "custom"
      ],
      "default": "none",
      "description": "Padr\u00e3o de recorr\u00eancia"
    },
    "recurring_days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Dias da semana (0=domingo, 6=s\u00e1bado) ou dias do m\u00eas"
    },
    "custom_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "description": "Datas espec\u00edficas para agenda vari\u00e1vel"
    },
    "reason": {
      "type": "string",
      "description": "Motivo do bloqueio"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o bloqueio est\u00e1 ativo"
    }
  },
  "required": [
    "professional_id",
    "block_type",
    "start_date"
  ]
}