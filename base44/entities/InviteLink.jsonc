{
  "name": "InviteLink",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do convidado"
    },
    "token": {
      "type": "string",
      "description": "Token \u00fanico do convite"
    },
    "role": {
      "type": "string",
      "enum": [
        "patient",
        "professional"
      ],
      "description": "Tipo de usu\u00e1rio convidado"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de expira\u00e7\u00e3o"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Se o convite foi utilizado"
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de uso"
    },
    "created_by": {
      "type": "string",
      "description": "Email do admin que gerou"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "email",
    "token",
    "role",
    "expires_at"
  ]
}