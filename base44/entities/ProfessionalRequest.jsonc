{
  "name": "ProfessionalRequest",
  "type": "object",
  "properties": {
    "professional_id": {
      "type": "string",
      "description": "ID do profissional"
    },
    "professional_name": {
      "type": "string",
      "description": "Nome do profissional"
    },
    "professional_email": {
      "type": "string",
      "format": "email",
      "description": "Email do profissional"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Status da solicita\u00e7\u00e3o"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email do admin que revisou"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da revis\u00e3o"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da rejei\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "professional_id",
    "professional_name",
    "professional_email"
  ]
}