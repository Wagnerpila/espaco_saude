{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "professional_id": {
      "type": "string",
      "description": "ID do profissional respons\u00e1vel"
    },
    "room_id": {
      "type": "string",
      "description": "ID da sala onde ser\u00e1 realizado"
    },
    "appointment_date": {
      "type": "string",
      "format": "date",
      "description": "Data do agendamento"
    },
    "appointment_time": {
      "type": "string",
      "description": "Hor\u00e1rio do agendamento (formato HH:MM)"
    },
    "duration": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "completed",
        "no_show",
        "justified_absence",
        "professional_absence",
        "null_absence"
      ],
      "default": "pending",
      "description": "Status do agendamento"
    },
    "service_type": {
      "type": "string",
      "description": "Tipo de servi\u00e7o/tratamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do agendamento"
    },
    "value": {
      "type": "number",
      "description": "Valor da consulta"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    }
  },
  "required": [
    "patient_id",
    "professional_id",
    "appointment_date",
    "appointment_time"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "professional"
          }
        },
        {
          "data.patient_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "professional"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "professional"
          }
        }
      ]
    }
  }
}