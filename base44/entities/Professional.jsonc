{
  "name": "Professional",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo do profissional"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade do profissional"
    },
    "crefito": {
      "type": "string",
      "description": "N\u00famero do CREFITO"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do profissional"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "E-mail do profissional"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio vinculado"
    },
    "default_commission_percentage": {
      "type": "number",
      "default": 0,
      "description": "Percentual padr\u00e3o de comiss\u00e3o do profissional"
    },
    "working_hours": {
      "type": "object",
      "description": "Hor\u00e1rios de trabalho por dia da semana",
      "properties": {
        "monday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "tuesday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "wednesday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "thursday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "friday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "saturday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        },
        "sunday": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "active": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o profissional est\u00e1 ativo"
    }
  },
  "required": [
    "full_name",
    "specialty",
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    }
  }
}