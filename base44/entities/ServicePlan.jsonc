{
  "name": "ServicePlan",
  "type": "object",
  "properties": {
    "plan_name": {
      "type": "string",
      "description": "Nome do plano (ex: Pilates 2x semana)"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "pilates",
        "fisioterapia",
        "estetica",
        "outros"
      ],
      "description": "Tipo de servi\u00e7o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do plano"
    },
    "default_value": {
      "type": "number",
      "description": "Valor padr\u00e3o do plano"
    },
    "sessions_per_cycle": {
      "type": "number",
      "description": "Quantidade de sess\u00f5es por ciclo (mensal, semanal, etc)"
    },
    "duration_minutes": {
      "type": "number",
      "default": 60,
      "description": "Dura\u00e7\u00e3o de cada sess\u00e3o em minutos"
    },
    "available_rooms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Salas dispon\u00edveis para o servi\u00e7o"
    },
    "available_professionals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos profissionais habilitados"
    },
    "allow_discount": {
      "type": "boolean",
      "default": true,
      "description": "Se permite aplicar desconto"
    },
    "max_discount_percentage": {
      "type": "number",
      "default": 20,
      "description": "Percentual m\u00e1ximo de desconto"
    },
    "commission_percentage": {
      "type": "number",
      "description": "Percentual de comiss\u00e3o espec\u00edfico para este servi\u00e7o (sobrescreve o padr\u00e3o do profissional)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o plano est\u00e1 ativo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o plano"
    }
  },
  "required": [
    "plan_name",
    "service_type",
    "default_value"
  ]
}