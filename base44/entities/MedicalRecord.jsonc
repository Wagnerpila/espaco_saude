{
  "name": "MedicalRecord",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "professional_id": {
      "type": "string",
      "description": "ID do profissional respons\u00e1vel"
    },
    "appointment_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "session_date": {
      "type": "string",
      "format": "date",
      "description": "Data da sess\u00e3o"
    },
    "diagnosis": {
      "type": "string",
      "description": "Diagn\u00f3stico ou avalia\u00e7\u00e3o"
    },
    "treatment": {
      "type": "string",
      "description": "Tratamento realizado"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da sess\u00e3o"
    },
    "next_session_notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es para pr\u00f3xima sess\u00e3o"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          }
        }
      },
      "description": "Anexos (exames, fotos, documentos)"
    }
  },
  "required": [
    "patient_id",
    "professional_id",
    "session_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "professional"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.professional_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.professional_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}