{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "payment_pending",
        "payment_confirmed",
        "appointment_confirmed",
        "appointment_cancelled",
        "new_appointment",
        "system_alert"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem da notifica\u00e7\u00e3o"
    },
    "patient_id": {
      "type": "string",
      "description": "ID do paciente relacionado"
    },
    "appointment_id": {
      "type": "string",
      "description": "ID do agendamento relacionado"
    },
    "financial_record_id": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o financeira relacionada"
    },
    "status": {
      "type": "string",
      "enum": [
        "unread",
        "read",
        "dismissed"
      ],
      "default": "unread",
      "description": "Status da notifica\u00e7\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Prioridade da notifica\u00e7\u00e3o"
    },
    "data": {
      "type": "object",
      "description": "Dados adicionais da notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ]
}