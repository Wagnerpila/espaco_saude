# Migração de dados a partir do base44 (usado só por scripts/export-base44.js)
# Opção A: cole aqui o access_token de uma sessão admin já logada (DevTools ->
# Application -> Local Storage -> chave "base44_access_token")
BASE44_APP_ID=""
BASE44_TOKEN=""
# Opção B: login/senha de um usuário admin (usado se BASE44_TOKEN estiver vazio)
